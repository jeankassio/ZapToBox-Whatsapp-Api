{
  "name": "zaptobox-whatsapp-api",
  "version": "1.3.0",
  "description": "REST API platform for integrating systems with WhatsApp with stability, multiple instances, message sending, and event webhooking. Ideal for automation, bots, and enterprise systems.",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node tools/patch-provider-streams.mjs && prisma generate && tsc",
    "postinstall": "node tools/patch-provider-streams.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "diagnose": "node tools/diagnose.mjs",
    "test": "node tools/patch-provider-streams.mjs && tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "build:start": "npm run build && npm start",
    "start:pm2": "pm2 startOrRestart ecosystem.config.json --only zaptobox-whatsapp-api --update-env",
    "restart:pm2": "npm run start:pm2",
    "build:pm2": "npm run build && npm run start:pm2",
    "pm2": "npm run start:pm2"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:jeankassio/ZapToBox-Whatsapp-Api.git"
  },
  "keywords": [
    "whatsapp",
    "api",
    "whatsapp-api",
    "whatsapp-business",
    "automation",
    "bots",
    "prisma",
    "baileys",
    "express",
    "nodejs",
    "typescript",
    "zaptobox",
    "jeankassio",
    "webhook",
    "multi-instance",
    "message-sending",
    "enterprise",
    "stability",
    "integration",
    "systems",
    "rest",
    "rest-api",
    "whatsapp-automation",
    "whatsapp-bots",
    "whatsapp-integration",
    "whatsapp-multi-instance",
    "whatsapp-message-sending",
    "whatsapp-enterprise",
    "whatsapp-stability",
    "whatsapp-zaptobox",
    "zaptoapi"
  ],
  "author": "Jean Kassio <jeankassio@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jeankassio/ZapToBox-Whatsapp-Api/issues"
  },
  "homepage": "https://github.com/jeankassio/ZapToBox-Whatsapp-Api#readme",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "https-proxy-agent": "^7.0.6",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "link-preview-js": "5.0.0",
    "node-cache": "^5.1.2",
    "pino": "^10.1.0",
    "prisma": "^6.19.0",
    "qrcode": "^1.5.4",
    "sharp": "0.35.4",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "link-preview-js": "$link-preview-js"
  }
}
