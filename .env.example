# Copie para .env e preencha o banco e os dois segredos antes de iniciar.
# Node.js 24+ / PostgreSQL 16+. API: 3001; Back: 3000; Front: 5500.
DATABASE_URL=postgresql://zaptobox:SUBSTITUA_A_SENHA@127.0.0.1:5432/zaptobox?schema=public
HOST=127.0.0.1
PORT=3001
# Gere cada segredo com node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_TOKEN=
# Mesmo valor de WEBHOOK_SECRET no ZapToBox novo - Back/.env
WEBHOOK_SECRET=
WEBHOOK_URL=http://127.0.0.1:3000/api/webhooks/whatsapp

# Credenciais e chaves Signal no PostgreSQL (recomendado).
# filesystem serve para desenvolvimento com apenas um processo.
AUTH_STORE=database
SESSION_FOLDER_NAME=sessions
SESSION=Linux
PHONE_NAME=Desktop
QRCODE_LIMIT=5
QRCODE_TIMEOUT=20
PROXY_URL=
HTTP_BODY_LIMIT=16mb
# Origens exatas autorizadas para buscar anexos do backend, separadas por vírgula.
# Em produção: https://backend.zaptobox.pro
TRUSTED_MEDIA_ORIGINS=http://127.0.0.1:3000

# Fila durável. QUEUE_INTERVAL continua em MINUTOS (0.1 = 6 segundos).
WEBHOOK_QUEUE=true
WEBHOOK_QUEUE_DIR=./webhook-queue
QUEUE_INTERVAL=0.1
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=30
WEBHOOK_CONCURRENCY=4

# Somente docker compose; use senha aleatória sem caracteres reservados de URL.
POSTGRES_USER=zaptobox
POSTGRES_PASSWORD=
POSTGRES_DB=zaptobox
DOCKER_WEBHOOK_URL=http://host.docker.internal:3000/api/webhooks/whatsapp
