// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  id               Int      @id @default(autoincrement())
  instance         String
  messageId        String
  remoteJid        String
  senderLid        String?
  fromMe           Boolean
  pushName         String?
  content          Json
  status           String?
  messageTimestamp BigInt

  @@unique([instance, messageId], name: "instance_messageId")
  @@index([instance])
  @@index([instance, id])
  @@index([remoteJid])
}

model Contact {
  id         Int     @id @default(autoincrement())
  instance   String
  name       String?
  jid        String?
  lid        String?

  @@unique([instance, jid], name: "instance_jid")
  @@unique([instance, lid], name: "instance_lid")
  @@index([instance])
  @@index([instance, id])
}

model Chat {
  id        Int    @id @default(autoincrement())
  instance  String
  jid       String
  data      Json

  @@unique([instance, jid], name: "instance_chat_jid")
  @@index([instance])
  @@index([instance, id])
}

// Credentials and all Signal key categories are persisted before Baileys proceeds.
model AuthState {
  instance  String
  type      String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([instance, type, key], name: "instance_type_key")
  @@index([instance])
}

// A pending page is frozen before crossing into the filesystem webhook outbox.
model HistoryRescanJob {
  id             String   @id @default(uuid())
  instance       String
  idempotencyKey String
  activeInstance String?  @unique
  runId          String   @unique
  status         String   @default("queued")
  state          Json
  pending        Json?
  attempts       Int      @default(0)
  errorCode      String?
  nextAttemptAt  DateTime @default(now())
  leaseToken     String?
  leaseUntil     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?

  @@unique([instance, idempotencyKey])
  @@index([status, nextAttemptAt, leaseUntil])
}
